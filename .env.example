# Stripe keys — NEVER commit the real .env file.
# Get the secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Stripe Payment Link for the $5 unlock. Create it at
# https://dashboard.stripe.com/payment-links — the server matches purchases
# back to installs via the client_reference_id query param it appends.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/6oU5kF2XFewhcHYfoGdjO04

# Server port
PORT=4242

# URL the extension will use to reach this server.
# For local testing, keep it as http://localhost:4242
# For production, use your HTTPS domain (e.g. https://billing.example.com)
BILLING_SERVER_URL=http://localhost:4242

# CORS origin allowed to call this server. Use the extension ID for production,
# or chrome-extension://* for local testing. Keep as * only for local dev.
CORS_ORIGIN=*
